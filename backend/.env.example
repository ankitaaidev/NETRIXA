# Copy to .env and adjust as needed. Never commit the real .env file.

APP_NAME=NETRIXA
ENVIRONMENT=development

# When true, the app must work fully offline with no DB and no FIRMS key.
DEMO_MODE=true

# Leave unset in demo mode. Example when using the Phase 3 PostGIS setup
# (docker-compose service name shown; use 127.0.0.1 for local, non-Docker dev):
# DATABASE_URL=postgresql+psycopg2://netrixa:netrixa_dev_password@postgis:5432/netrixa
DATABASE_URL=

# Comma-separated list handled by pydantic-settings as a JSON-like list env var;
# simplest is to just edit CORS_ORIGINS in app/core/config.py defaults for local dev.

# NASA FIRMS API key (never hard-code this in source). Optional in demo mode.
FIRMS_API_KEY=

# Risk thresholds (0-100 scale), see app/core/config.py for defaults.
RISK_LOW_MAX=25
RISK_MEDIUM_MAX=50
RISK_HIGH_MAX=75
